datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id // Matches Supabase Auth user.id
  email          String          @unique
  role           String          @default("USER") // USER or ADMIN
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userChallenges UserChallenge[]
  dailyEntries   DailyEntry[]

  @@map("users")
}

model ChallengeTemplate {
  id          String   @id @default(cuid())
  title       String
  description String
  duration    Int      // e.g., 10, 21, 30 days
  prompts     Json     // Array of strings: ["How did it feel?", "What did you learn?"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userChallenges UserChallenge[]

  @@map("challenge_templates")
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model UserChallenge {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeTemplateId String
  template            ChallengeTemplate @relation(fields: [challengeTemplateId], references: [id], onDelete: Cascade)
  startDate           DateTime          @default(now())
  endDate             DateTime?
  status              ChallengeStatus   @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  entries             DailyEntry[]

  @@index([userId, status])
  @@map("user_challenges")
}

model DailyEntry {
  id              String             @id @default(cuid())
  userChallengeId String
  userChallenge   UserChallenge      @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayNumber       Int                
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  responses       QuestionResponse[]

  @@unique([userChallengeId, dayNumber])
  @@index([userId, dayNumber])
  @@map("daily_entries")
}

model QuestionResponse {
  id           String     @id @default(cuid())
  dailyEntryId String
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  promptText   String
  answerText   String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("question_responses")
}
